{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloaktools",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "tools.cloakyard.com", "custom_domain": true }]
}
